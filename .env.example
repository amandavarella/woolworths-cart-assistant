# Where the dedicated browser profile is stored (keeps you logged in between runs).
# This directory is created on first run; do NOT point it at your real Chrome profile.
PROFILE_DIR=./.browser-profile

# Run the browser without a visible window. Keep false for the first run so you can log in.
HEADLESS=false

# Use your installed Google Chrome instead of Playwright's bundled Chromium.
# Recommended (matches what was verified). Set to "" to use bundled Chromium.
BROWSER_CHANNEL=chrome

# How Clove items are collected.
#   paste (default): the Clove website is no longer live, so you paste your
#                    Clove list into CLOVE_LIST_FILE and it is parsed locally.
#   web:             re-enable the legacy browser scraper against CLOVE_URL.
CLOVE_MODE=paste

# Paste-mode input: text file you paste your Clove ingredients into, one per
# line. Blank lines and lines starting with "#" are ignored. Created for you
# (as a template) on first run if it doesn't exist.
CLOVE_LIST_FILE=./clove-list.txt

# Clove groceries page (only used when CLOVE_MODE=web).
CLOVE_URL=https://clove.kitchen/groceries

# AnyList account credentials (read via the unofficial AnyList API — no browser).
# Leave blank if you don't use AnyList; the pipeline will skip that source.
ANYLIST_EMAIL=
ANYLIST_PASSWORD=

# The exact name of the AnyList list to read. Defaults to "Groceries".
ANYLIST_LIST_NAME=Groceries

# Optional: where the encrypted AnyList token cache is stored (git-ignored).
# ANYLIST_CREDENTIALS_FILE=./.anylist_credentials

# Woolworths base URL.
WOOLWORTHS_URL=https://www.woolworths.com.au

# Optional: sync preferred items from a specific past order. Set either the
# bare order id or a full order URL. Leave both unset to use your latest order.
# ORDER_ID=310959361
# ORDER_URL=https://www.woolworths.com.au/shop/myaccount/myorders/310959361

# Path to your preferred items list (one Woolworths product name per line).
PREFERRED_ITEMS_FILE=./preferred-items.txt

# Path to your ignore list (one item per line). Ingredients from Clove/AnyList
# that match a line here are dropped before mapping and never added to the cart.
IGNORE_ITEMS_FILE=./ignore-items.txt

# Safety cap on the quantity of any single product added to the cart.
MAX_QTY=12

# Where skills write their hand-off files and reports (clove-items.json,
# shopping-plan.json, results.json). Git-ignored.
OUTPUT_DIR=./output

# Optional: process only the first N Clove ingredients (handy for testing).
# LIMIT=5
